# 백엔드(Spring) 주소. 로컬 개발은 vite 프록시(/api)가 이 주소로 넘긴다.
VITE_BACKEND_BASE_URL=http://localhost:8080
# 선택: API 호출 기준 주소(기본값은 VITE_BACKEND_BASE_URL)
# VITE_API_BASE_URL=
# 선택: 표정 분석(MediaPipe) 자산 주소. 비우면 공개 CDN 기본값을 쓴다.
# VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm
# VITE_FACE_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task
# VITE_DEMO_SKIP=true  # 개발·시연용: 숙지 화면에 건너뛰기 버튼 표시(운영에서는 설정하지 말 것)
